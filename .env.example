# Публичный адрес приложения (куда ведёт redirect после Spotify OAuth)
# dev:   http://localhost:5173  (vite proxy -> сервер на 8787)
# prod:  https://your-domain.com (сервер сам отдаёт собранный фронтенд)
BASE_URL=http://localhost:5173

# Порт бэкенда
PORT=8787

# --- Spotify (https://developer.spotify.com/dashboard) ---
# Redirect URI, который нужно добавить в приложение: ${BASE_URL}/api/spotify/callback
SPOTIFY_CLIENT_ID=
# Опционально (нужен для refresh token у публичных клиентов с PKCE — обычно пусто)
SPOTIFY_CLIENT_SECRET=

# --- Twitch-бот (опционально) ---
# Без токена бот анонимно ЧИТАЕТ чат (justinfan), но не может отвечать в чате.
# С токеном — полноценно отвечает на команды.
# Токен можно получить через любой OAuth-генератор чат-ботов с scope chat:read chat:edit
TWITCH_BOT_NICK=
TWITCH_BOT_OAUTH=

# SQLite
DB_PATH=data/tunequeue.db
