{
  "manifest_version": 3,
  "name": "TuneQueue",
  "version": "0.2.0",
  "description": "Song requests for Twitch: viewers post !sr <link> in chat, the track is added to Spotify's queue.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://irc-ws.chat.twitch.tv/*",
    "https://open.spotify.com/*",
    "https://spotify.link/*",
    "https://id.twitch.tv/*",
    "https://api.twitch.tv/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TuneQueue",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["lib/parse.js", "config.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
